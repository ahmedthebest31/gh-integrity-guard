{
  "manifest_version": 3,
  "name": "GitHub Integrity Guard",
  "version": "1.0.0",
  "description": "Provides instant transparency regarding the authenticity and health of GitHub repositories.",
  "permissions": [
    "storage",
    "declarativeContent"
  ],
  "host_permissions": [
    "https://github.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
